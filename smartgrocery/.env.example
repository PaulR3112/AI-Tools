# Skopíruj do .env a doplň. .env sa necommituje.

# Claude API – extrakcia letákov
ANTHROPIC_API_KEY=
SG_LLM_MODEL=claude-opus-5
SG_LLM_EFFORT=high
SG_LLM_DAILY_COST_LIMIT_USD=5
# cena za 1M tokenov – over podľa aktuálneho cenníka
SG_LLM_PRICE_INPUT_PER_MTOK=5
SG_LLM_PRICE_OUTPUT_PER_MTOK=25

# Admin API (/v1/admin/*) – bez zmeny je vypnuté
SG_ADMIN_TOKEN=change-me

# User-Agent s kontaktom pre sťahovanie zo zdrojov
SG_HTTP_USER_AGENT=SmartGroceryBot/0.1 (+mailto:tvoj@email.cz)

# Lokálne mimo Dockeru:
# SG_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smartgrocery
# SG_STORAGE_DIR=./data/raw
