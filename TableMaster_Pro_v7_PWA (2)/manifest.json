{
  "id": "/tablemaster-pro/",
  "name": "TableMaster Pro",
  "short_name": "TableMaster",
  "description": "Profesionálny editor tabuliek s offline podporou",
  "version": "7.1.0",
  "start_url": "./index.html",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f3f4f6",
  "theme_color": "#2563eb",
  "orientation": "any",
  "scope": "./",
  "lang": "sk",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.ms-excel": [".xls"],
        "text/html": [".html", ".htm"],
        "application/json": [".json"]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Nová tabuľka",
      "short_name": "Nová",
      "description": "Vytvoriť novú prázdnu tabuľku",
      "url": "./index.html?action=new"
    },
    {
      "name": "Otvoriť súbor",
      "short_name": "Otvoriť",
      "description": "Otvoriť existujúci súbor",
      "url": "./index.html?action=open"
    }
  ]
}
